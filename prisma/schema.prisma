generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            Int       @id @default(autoincrement())
  name          String
  email         String    @unique
  password_hash String
  role          String    // "PRINCIPAL" or "TEACHER"
  created_at    DateTime  @default(now())
  contents      Content[] @relation("teacher_contents")
  approvals     Content[] @relation("principal_approvals")
}

model Content {
  id               Int              @id @default(autoincrement())
  title            String
  description      String?
  subject          String
  file_path        String
  file_type        String
  file_size        Int
  status           String           @default("UPLOADED") // UPLOADED, PENDING, APPROVED, REJECTED
  rejection_reason String?
  start_time       DateTime?
  end_time         DateTime?
  
  uploaded_by_id   Int
  uploaded_by      User             @relation("teacher_contents", fields: [uploaded_by_id], references: [id])
  
  approved_by_id   Int?
  approved_by      User?            @relation("principal_approvals", fields: [approved_by_id], references: [id])
  approved_at      DateTime?
  created_at       DateTime         @default(now())
  
  schedule         ContentSchedule?
}

model ContentSlot {
  id         Int               @id @default(autoincrement())
  subject    String            @unique
  schedules  ContentSchedule[]
  created_at DateTime          @default(now())
}

model ContentSchedule {
  id             Int         @id @default(autoincrement())
  content_id     Int         @unique
  content        Content     @relation(fields: [content_id], references: [id])
  slot_id        Int
  slot           ContentSlot @relation(fields: [slot_id], references: [id])
  rotation_order Int
  duration       Float       // in minutes
  created_at     DateTime    @default(now())
}
